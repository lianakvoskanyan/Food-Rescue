# Sanity (public)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Sanity (server only — never commit real tokens)
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Auth.js — email/password (server only)
AUTH_SECRET=
# Site URL (Auth.js sign-in/out redirects). Local dev:
AUTH_URL=http://localhost:3000
# Vercel Production: use your domain (or omit if wrongly set to localhost — app auto-uses VERCEL_URL)
# AUTH_URL=https://food-rescue-tau-three.vercel.app
# NEXT_PUBLIC_SITE_URL=https://food-rescue-tau-three.vercel.app
# AUTH_SECRET=<openssl rand -base64 32>
